---
interface Props {
  inverted?: boolean;
}
const { inverted = false } = Astro.props;
---

<span class="inline-flex items-center gap-2.5">
  <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true" class="shrink-0">
    <circle cx="16" cy="16" r="15" fill={inverted ? '#f6f1e8' : '#1f3d2f'} />
    <path
      d="M10 21.5c0-7 5-11.5 12.5-12-.3 7.6-4.6 12.3-11.3 12.3"
      fill="none"
      stroke={inverted ? '#1f3d2f' : '#f6f1e8'}
      stroke-width="1.8"
      stroke-linecap="round"
    />
    <path d="M10.4 22.4 17 15.5" stroke="#b08d57" stroke-width="1.8" stroke-linecap="round" />
  </svg>
  <span class:list={['flex flex-col font-serif text-[1.15rem] leading-none tracking-tight', inverted ? 'text-linen-100' : 'text-forest-900']}>
    GreenStay <span class:list={['mt-1 font-sans text-[0.62rem] font-semibold uppercase tracking-[0.24em]', inverted ? 'text-sand-300' : 'text-brass-700']}>Consultancy</span>
  </span>
</span>
