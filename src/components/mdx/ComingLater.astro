---
/** Placeholder block for chapters that are written later in the project. */
interface Props { items: string[]; when?: string }
const { items, when = 'Coming later in the project' } = Astro.props;
---

<div class="wide not-prose reveal max-w-4xl rounded-2xl border border-dashed border-sand-300 bg-white/70 p-6 sm:p-10">
  <div class="flex items-center gap-3">
    <span class="relative flex h-2.5 w-2.5">
      <span class="absolute inline-flex h-full w-full rounded-full bg-brass-500/40 motion-safe:animate-ping"></span>
      <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-brass-500"></span>
    </span>
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brass-700">{when}</p>
  </div>
  <h2 class="mt-4 font-serif text-2xl text-forest-900 sm:text-3xl">What this chapter will contain</h2>
  <ul class="mt-6 grid gap-3">
    {items.map((item) => (
      <li class="flex gap-3 text-[1rem] leading-relaxed text-charcoal-700">
        <svg class="mt-1 h-5 w-5 shrink-0 text-eucalyptus-500" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="10" cy="10" r="8" /><path d="M10 6v4l2.5 2" stroke-linecap="round" />
        </svg>
        <span>{item}</span>
      </li>
    ))}
  </ul>
</div>
