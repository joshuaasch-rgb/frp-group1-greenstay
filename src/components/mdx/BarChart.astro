---
/**
 * Horizontal bar chart for percentages. Data lives in src/data/charts.json.
 * Usage in a chapter:  <BarChart id="booking" figure="1" />
 */
import charts from '../../data/charts.json';

interface Props {
  id: keyof typeof charts;
  figure?: string;
}

const { id, figure } = Astro.props;
const chart = charts[id];
if (!chart) throw new Error(`Unknown chart "${id}" – add it to src/data/charts.json`);
const ticks = [0, 25, 50, 75, 100];
const max = Math.max(...chart.bars.map((b) => b.value));
---

<figure class="reveal not-prose my-10 rounded-xl border border-sand-200 bg-white p-5 shadow-[0_1px_0_rgba(0,0,0,0.02)] sm:p-7">
  <figcaption class="mb-6">
    {figure && <span class="block text-xs font-semibold uppercase tracking-[0.16em] text-brass-700">Figure {figure}</span>}
    <span class="mt-1 block font-serif text-lg leading-snug text-forest-900 sm:text-xl">{chart.title}</span>
    <span class="mt-1 block text-sm text-charcoal-500">{chart.unit}</span>
  </figcaption>

  <div class="bar-chart relative" aria-hidden="true">
    <div class="pointer-events-none absolute inset-0 flex justify-between">
      {ticks.map(() => <span class="h-full w-px bg-sand-200/80" />)}
    </div>
    <ul class="relative space-y-5">
      {chart.bars.map((bar) => (
        <li class="group" title={`${bar.label}: ${bar.value}%`}>
          <div class="mb-1.5 flex items-baseline justify-between gap-4 pr-1 text-[0.92rem] leading-snug text-charcoal-700">
            <span>{bar.label}</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="h-4 flex-1">
              <div
                class:list={[
                  'bar-fill h-full rounded-r-[4px] transition-[filter]',
                  bar.value === max ? 'bg-forest-700' : 'bg-eucalyptus-500',
                  'group-hover:brightness-110',
                ]}
                style={`--w:${bar.value}%`}
              />
            </div>
            <span class="w-12 shrink-0 text-right font-serif text-lg font-semibold tabular-nums text-forest-900">{bar.value}%</span>
          </div>
        </li>
      ))}
    </ul>
    <div class="mt-3 flex justify-between pr-[3.75rem] text-[0.7rem] tabular-nums text-charcoal-500">
      {ticks.map((t) => <span>{t}</span>)}
    </div>
  </div>

  <div class="sr-only">
  <table>
    <caption>{chart.title} ({chart.unit})</caption>
    <thead><tr><th scope="col">Group</th><th scope="col">Value</th></tr></thead>
    <tbody>
      {chart.bars.map((bar) => (<tr><td>{bar.label}</td><td>{bar.value}%</td></tr>))}
    </tbody>
  </table>
  </div>

  <p class="mt-6 border-t border-sand-200 pt-4 text-xs leading-relaxed text-charcoal-500">
    <span class="font-semibold text-charcoal-700">Source:</span> {chart.source}
  </p>
</figure>

<style>
  /* Bars span the track minus the value column; the grid lines use the same width. */
  .bar-chart > div:first-child { right: 3.75rem; }
  .bar-fill { width: var(--w); }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .reveal .bar-fill {
      width: 0;
      transition: width 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.2s;
    }
    :global(.js) .reveal:global(.is-visible) .bar-fill { width: var(--w); }
  }
</style>
