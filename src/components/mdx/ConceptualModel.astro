---
/**
 * Conceptual model (Figure). Two drawings of the same model:
 * a wide one for tablet/desktop and a stacked one for phones.
 */
interface Props {
  figure?: string;
}
const { figure } = Astro.props;

const ivs = [
  { h: 'H1', lines: ['Environmental concern'] },
  { h: 'H2', lines: ['Social norms'] },
  { h: 'H3', lines: ['Perceived convenience'] },
  { h: 'H4', lines: ['Perceived personal benefits', '(incentives & rewards)'] },
];
const dv = ['Intention to participate', 'in hotel sustainability', 'practices'];
const demo = ['Gender · age · travel purpose', '(business vs. leisure) · length of stay'];

// Wide layout geometry
const W = { ivX: 24, ivW: 300, ivH: 72, gap: 28, top: 58, dvX: 636, dvW: 300 };
const ivY = ivs.map((_, i) => W.top + i * (W.ivH + W.gap));
const dvY = 152;
const dvH = 124;
const dvMid = dvY + dvH / 2;
const ends = [-39, -13, 13, 39].map((d) => dvMid + d);

// Stacked (phone) layout geometry
const M = { x: 12, w: 196, h: 64, gap: 14, top: 42, dvX: 280, dvW: 108 };
const mY = ivs.map((_, i) => M.top + i * (M.h + M.gap));
const mDvY = M.top + 36;
const mDvH = 4 * M.h + 3 * M.gap - 72;
const mDvMid = mDvY + mDvH / 2;
const mEnds = [-45, -15, 15, 45].map((d) => mDvMid + d);
const mBottom = M.top + 4 * M.h + 3 * M.gap;
---

<figure class="wide reveal not-prose my-12 rounded-xl border border-sand-200 bg-white p-4 sm:p-8" id="conceptual-model-figure">
  <!-- Wide version -->
  <svg class="hidden h-auto w-full sm:block" viewBox="0 0 960 470" role="img" aria-labelledby="cm-title cm-desc">
    <title id="cm-title">Conceptual model</title>
    <desc id="cm-desc">
      Four independent variables – environmental concern (H1), social norms (H2), perceived convenience (H3) and
      perceived personal benefits (H4) – are each expected to have a positive effect on the dependent variable:
      intention to participate in hotel sustainability practices. Demographic variables (gender, age, travel purpose,
      length of stay) are used to compare guest groups.
    </desc>
    <defs>
      <marker id="cm-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 10 5 0 10z" fill="#2b5240" />
      </marker>
    </defs>

    <text x={W.ivX} y="34" class="cm-kicker">Independent variables</text>
    <text x={W.dvX} y={dvY - 18} class="cm-kicker">Dependent variable</text>

    {ivs.map((iv, i) => {
      const cy = ivY[i] + W.ivH / 2;
      const x1 = W.ivX + W.ivW;
      const x2 = W.dvX - 4;
      const mx = (x1 + x2) / 2;
      const my = (cy + ends[i]) / 2;
      return (
        <g>
          <rect x={W.ivX} y={ivY[i]} width={W.ivW} height={W.ivH} rx="10" fill="#e1ebe4" stroke="#4f7a65" stroke-width="1.5" />
          {iv.lines.map((line, j) => (
            <text
              x={W.ivX + W.ivW / 2}
              y={cy + (j - (iv.lines.length - 1) / 2) * 21 + 6}
              text-anchor="middle"
              class:list={[j === 0 ? 'cm-label' : 'cm-sub']}
            >{line}</text>
          ))}
          <line x1={x1} y1={cy} x2={x2} y2={ends[i]} stroke="#2b5240" stroke-width="1.75" marker-end="url(#cm-arrow)" />
          <rect x={mx - 30} y={my - 14} width="60" height="28" rx="14" fill="#fbf8f3" stroke="#b08d57" stroke-width="1.25" />
          <text x={mx} y={my + 5} text-anchor="middle" class="cm-h">{iv.h} +</text>
        </g>
      );
    })}

    <rect x={W.dvX} y={dvY} width={W.dvW} height={dvH} rx="12" fill="#1f3d2f" />
    {dv.map((line, j) => (
      <text x={W.dvX + W.dvW / 2} y={dvMid + (j - 1) * 24 + 7} text-anchor="middle" class="cm-dv">{line}</text>
    ))}

    <rect x={W.dvX} y="330" width={W.dvW} height="96" rx="10" fill="none" stroke="#5d646a" stroke-width="1.25" stroke-dasharray="6 5" />
    <text x={W.dvX + W.dvW / 2} y="360" text-anchor="middle" class="cm-demo-title">Demographic variables</text>
    {demo.map((line, j) => (
      <text x={W.dvX + W.dvW / 2} y={384 + j * 20} text-anchor="middle" class="cm-demo">{line}</text>
    ))}
  </svg>

  <!-- Phone version -->
  <svg class="h-auto w-full sm:hidden" viewBox={`0 0 400 ${mBottom + 140}`} role="img" aria-labelledby="cm-title-m">
    <title id="cm-title-m">Conceptual model: environmental concern (H1), social norms (H2), perceived convenience (H3) and perceived personal benefits (H4) each positively influence intention to participate in hotel sustainability practices; demographic variables are used to compare groups.</title>
    <defs>
      <marker id="cm-arrow-m" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 10 5 0 10z" fill="#2b5240" />
      </marker>
    </defs>
    <text x={M.x} y="26" class="cm-kicker-m">Independent variables</text>
    {ivs.map((iv, i) => {
      const cy = mY[i] + M.h / 2;
      const x1 = M.x + M.w;
      const x2 = M.dvX - 3;
      const words = iv.h === 'H4' ? ['Perceived personal', 'benefits'] : iv.h === 'H3' ? ['Perceived', 'convenience'] : iv.h === 'H1' ? ['Environmental', 'concern'] : ['Social norms'];
      return (
        <g>
          <rect x={M.x} y={mY[i]} width={M.w} height={M.h} rx="9" fill="#e1ebe4" stroke="#4f7a65" stroke-width="1.5" />
          {words.map((w, j) => (
            <text x={M.x + M.w / 2} y={cy + (j - (words.length - 1) / 2) * 20 + 6} text-anchor="middle" class="cm-label-m">{w}</text>
          ))}
          <line x1={x1} y1={cy} x2={x2} y2={mEnds[i]} stroke="#2b5240" stroke-width="1.75" marker-end="url(#cm-arrow-m)" />
          <rect x={(x1 + x2) / 2 - 24} y={(cy + mEnds[i]) / 2 - 12} width="48" height="24" rx="12" fill="#fbf8f3" stroke="#b08d57" stroke-width="1.25" />
          <text x={(x1 + x2) / 2} y={(cy + mEnds[i]) / 2 + 5} text-anchor="middle" class="cm-h-m">{iv.h}+</text>
        </g>
      );
    })}
    <rect x={M.dvX} y={mDvY} width={M.dvW} height={mDvH} rx="10" fill="#1f3d2f" />
    {['Intention to', 'participate in', 'hotel', 'sustainability', 'practices'].map((w, j) => (
      <text x={M.dvX + M.dvW / 2} y={mDvMid + (j - 2) * 21 + 6} text-anchor="middle" class="cm-dv-m">{w}</text>
    ))}
    <text x={M.dvX + M.dvW / 2} y={mDvY - 12} text-anchor="middle" class="cm-kicker-m">DV</text>
    <rect x={M.x} y={mBottom + 28} width={400 - 2 * M.x} height="92" rx="9" fill="none" stroke="#5d646a" stroke-width="1.25" stroke-dasharray="6 5" />
    <text x="200" y={mBottom + 58} text-anchor="middle" class="cm-demo-title-m">Demographic variables</text>
    <text x="200" y={mBottom + 82} text-anchor="middle" class="cm-demo-m">Gender · age · travel purpose</text>
    <text x="200" y={mBottom + 104} text-anchor="middle" class="cm-demo-m">(business vs. leisure) · length of stay</text>
  </svg>

  <figcaption class="mt-6 border-t border-sand-200 pt-4 text-sm leading-relaxed text-charcoal-500">
    {figure && <span class="font-semibold text-charcoal-700">Figure {figure}. </span>}
    Conceptual model, own elaboration based on Ajzen (1991), Budovska et al. (2020) and Dolnicar et al. (2019).
  </figcaption>
</figure>

<style>
  svg text { font-family: var(--font-sans); }
  .cm-kicker, .cm-kicker-m { font-size: 13px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; fill: #7d6034; }
  .cm-kicker-m { font-size: 12px; }
  .cm-label { font-size: 18px; font-weight: 600; fill: #173225; }
  .cm-sub { font-size: 15px; fill: #3d4348; }
  .cm-h { font-size: 14px; font-weight: 700; fill: #7d6034; }
  .cm-dv { font-family: var(--font-serif); font-size: 21px; fill: #fbf8f3; }
  .cm-demo-title { font-size: 15px; font-weight: 600; fill: #3d4348; }
  .cm-demo { font-size: 14px; fill: #5d646a; }
  .cm-label-m { font-size: 16px; font-weight: 600; fill: #173225; }
  .cm-h-m { font-size: 13px; font-weight: 700; fill: #7d6034; }
  .cm-dv-m { font-family: var(--font-serif); font-size: 16px; fill: #fbf8f3; }
  .cm-demo-title-m { font-size: 16px; font-weight: 600; fill: #3d4348; }
  .cm-demo-m { font-size: 15px; fill: #5d646a; }
</style>
