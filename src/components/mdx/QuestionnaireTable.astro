---
/** Questionnaire breakout table. Items live in src/data/questionnaire.json. */
import q from '../../data/questionnaire.json';
---

<div class="wide not-prose my-10">
  <div class="grid gap-4">
    {q.constructs.map((c) => (
      <section class="reveal overflow-hidden rounded-xl border border-sand-200 bg-white">
        <header class="flex flex-col gap-1 border-b border-sand-200 bg-linen-100 px-5 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
          <h3 class="font-serif text-lg text-forest-900">{c.name}</h3>
          <p class="text-xs text-charcoal-500"><span class="font-semibold">Based on:</span> {c.basedOn}</p>
        </header>
        <ol class="divide-y divide-sand-200/70">
          {c.items.map((item, i) => {
            const reversed = item.endsWith('(R)');
            return (
              <li class="flex gap-4 px-5 py-3 text-[0.95rem] leading-relaxed text-charcoal-700">
                <span class="w-5 shrink-0 text-right tabular-nums text-charcoal-500">{i + 1}.</span>
                <span>
                  {reversed ? item.replace(/\s*\(R\)$/, '') : item}
                  {reversed && <abbr title="Negatively worded, recoded before analysis" class="ml-2 rounded bg-sand-200 px-1.5 py-0.5 text-xs font-semibold text-brass-700 no-underline">R</abbr>}
                </span>
              </li>
            );
          })}
        </ol>
      </section>
    ))}
  </div>
  <p class="mt-4 text-sm leading-relaxed text-charcoal-500">{q.note}</p>
</div>
