---
/** Sub-questions as cards. */
interface Props { items: { id: string; method: string; text: string }[] }
const { items } = Astro.props;
---

<ol class="not-prose my-8 grid gap-4">
  {items.map((q) => (
    <li class="reveal rounded-xl border border-sand-200 bg-white p-5 sm:p-6">
      <div class="flex flex-wrap items-center gap-3">
        <span class="font-serif text-xl text-forest-900">{q.id}</span>
        <span class="rounded-full bg-linen-100 px-3 py-1 text-xs font-medium text-brass-700 ring-1 ring-sand-200">{q.method}</span>
      </div>
      <p class="mt-3 text-[1rem] leading-relaxed text-charcoal-700">{q.text}</p>
    </li>
  ))}
</ol>
