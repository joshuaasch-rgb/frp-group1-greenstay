---
import Logo from './Logo.astro';
import site from '../data/site.json';
import { nav } from '../lib/nav';
import { url } from '../lib/url';
import { photoCredits } from '../lib/photos';
---

<footer class="mt-24 bg-forest-900 text-sand-300">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 py-16 md:grid-cols-12 md:px-8">
    <div class="md:col-span-5">
      <Logo inverted />
      <p class="mt-5 max-w-sm text-[0.95rem] leading-relaxed text-sand-300/90">
        {site.projectTitle}. A research project by {site.group}, {site.course}.
      </p>
    </div>

    <div class="md:col-span-3">
      <h2 class="font-sans text-xs font-semibold uppercase tracking-[0.18em] text-brass-500">The report</h2>
      <ul class="mt-4 space-y-2 text-[0.95rem]">
        {nav.map((item) => (
          <li><a class="hover:text-white" href={url(`${item.slug}/`)}>{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="md:col-span-4">
      <h2 class="font-sans text-xs font-semibold uppercase tracking-[0.18em] text-brass-500">Contact</h2>
      <address class="mt-4 text-[0.95rem] not-italic leading-relaxed">
        {site.university}<br />
        {site.address.map((line) => (<>{line}<br /></>))}
      </address>
      <p class="mt-4 text-[0.95rem] leading-relaxed">
        {site.group}: {site.members.join(', ')}<br />
        Research coach: {site.coach}
      </p>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-7xl flex-col gap-3 px-5 py-6 text-xs leading-relaxed text-sand-300/80 md:flex-row md:items-start md:justify-between md:px-8">
      <p>© {new Date().getFullYear()} {site.group} · {site.course} · {site.university}</p>
      <p class="md:max-w-xl md:text-right">
        Photos via Unsplash:{' '}
        {photoCredits.map((c, i) => (
          <>
            <a class="underline decoration-white/30 underline-offset-2 hover:text-white" href={c.url} rel="noopener">{c.author}</a>{i < photoCredits.length - 1 ? ', ' : '.'}
          </>
        ))}
      </p>
    </div>
  </div>
</footer>
